[
 {
  "start": 0.8,
  "end": 2.982,
  "text": "Bayangkan hidup 200 tahun dahulu."
 },
 {
  "start": 3.622,
  "end": 5.984,
  "text": "Anda mengalami suara yang orang lain tak dengar,"
 },
 {
  "start": 6.545,
  "end": 8.346,
  "text": "atau kesedihan yang terlalu berat."
 },
 {
  "start": 8.927,
  "end": 11.769,
  "text": "Adakah masyarakat ketika itu tahu cara membantu anda?"
 },
 {
  "start": 15.32,
  "end": 18.662,
  "text": "Sebenarnya, gangguan mental bukan fenomena baharu."
 },
 {
  "start": 19.342,
  "end": 20.342,
  "text": "Sejak zaman purba,"
 },
 {
  "start": 20.742,
  "end": 23.123,
  "text": "manusia cuba memahami perubahan emosi,"
 },
 {
  "start": 23.484,
  "end": 25.084,
  "text": "pemikiran dan tingkah laku."
 },
 {
  "start": 25.785,
  "end": 26.785,
  "text": "Di sesetengah tempat,"
 },
 {
  "start": 27.065,
  "end": 29.206,
  "text": "gejalanya dikaitkan dengan unsur ghaib."
 },
 {
  "start": 29.726,
  "end": 32.788,
  "text": "Tetapi pandangan berbeza mengikut budaya dan zaman."
 },
 {
  "start": 34.0,
  "end": 35.282,
  "text": "Lebih 2,000 tahun lalu,"
 },
 {
  "start": 35.762,
  "end": 38.146,
  "text": "Hippocrates di Yunani mencadangkan bahawa"
 },
 {
  "start": 38.246,
  "end": 40.589,
  "text": "gangguan mental ada punca semula jadi."
 },
 {
  "start": 41.27,
  "end": 43.493,
  "text": "Teorinya tentang keseimbangan cecair badan"
 },
 {
  "start": 43.653,
  "end": 44.934,
  "text": "kini tidak lagi diterima,"
 },
 {
  "start": 45.455,
  "end": 48.259,
  "text": "namun idea mengkaji keadaan mental melalui"
 },
 {
  "start": 48.299,
  "end": 50.822,
  "text": "perubatan merupakan satu perubahan penting."
 },
 {
  "start": 51.88,
  "end": 53.821,
  "text": "Kemudian, sepanjang sejarah,"
 },
 {
  "start": 54.141,
  "end": 57.202,
  "text": "sebahagian individu ditempatkan di institusi jagaan."
 },
 {
  "start": 57.903,
  "end": 59.143,
  "text": "Ada yang menerima bantuan,"
 },
 {
  "start": 59.483,
  "end": 61.844,
  "text": "tetapi ada juga yang mengalami pengasingan"
 },
 {
  "start": 61.984,
  "end": 64.045,
  "text": "dan layanan tidak berperikemanusiaan."
 },
 {
  "start": 64.626,
  "end": 67.347,
  "text": "Pada penghujung abad ke-18, tokoh seperti"
 },
 {
  "start": 67.447,
  "end": 70.008,
  "text": "Philippe Pinel dan William Tuke memperjuangkan"
 },
 {
  "start": 70.068,
  "end": 72.229,
  "text": "pendekatan yang lebih berperikemanusiaan."
 },
 {
  "start": 73.42,
  "end": 77.384,
  "text": "Menjelang tahun 1952, penggunaan chlorpromazine"
 },
 {
  "start": 77.444,
  "end": 79.787,
  "text": "dalam psikiatri membuka lembaran baharu"
 },
 {
  "start": 79.867,
  "end": 82.37,
  "text": "rawatan ubat untuk sesetengah gangguan mental."
 },
 {
  "start": 83.01,
  "end": 84.472,
  "text": "Penyelidikan terus berkembang,"
 },
 {
  "start": 84.872,
  "end": 87.976,
  "text": "seiring usaha memperbaiki hak dan penjagaan pesakit."
 },
 {
  "start": 89.0,
  "end": 91.822,
  "text": "Hari ini, rawatan boleh melibatkan psikoterapi,"
 },
 {
  "start": 92.342,
  "end": 93.482,
  "text": "ubat apabila sesuai,"
 },
 {
  "start": 94.003,
  "end": 96.584,
  "text": "sokongan keluarga dan pemulihan dalam komuniti."
 },
 {
  "start": 97.244,
  "end": 99.465,
  "text": "Tetapi satu cabaran masih wujud:"
 },
 {
  "start": 100.046,
  "end": 100.486,
  "text": "stigma."
 },
 {
  "start": 101.266,
  "end": 103.948,
  "text": "Sejarah mengajar kita bahawa pengetahuan berubah,"
 },
 {
  "start": 104.448,
  "end": 107.39,
  "text": "namun maruah manusia tidak patut dikompromi."
 },
 {
  "start": 108.03,
  "end": 110.111,
  "text": "Penyakit mental bukan tanda lemah."
 },
 {
  "start": 110.651,
  "end": 113.533,
  "text": "Dan meminta bantuan bukan sesuatu yang memalukan."
 },
 {
  "start": 114.173,
  "end": 116.454,
  "text": "Mari ubah cara kita melihat kesihatan mental."
 }
]